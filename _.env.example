# Copia este archivo como .env y cambia las contraseñas. No subas .env a GitHub.
DB_ROOT_PASS=cambia_esta_clave_root
DB_NAME=control_escolar
DB_USER=escolar_user
DB_PASS=cambia_esta_clave_app

# Puertos publicados en tu equipo. Si XAMPP está encendido, usa puertos distintos
# a 3306 (MariaDB de XAMPP) y 80 (Apache de XAMPP).
DB_HOST_PORT=3307
WEB_PORT=8080
